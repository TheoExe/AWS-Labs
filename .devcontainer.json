{
  "name": "AWS-CLI",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",
  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {},  
  // https://docs.aws.amazon.com/powershell/v5/reference/items/pstoolsref-welcome.html
    "ghcr.io/devcontainers/features/powershell:2.0.2": {},
     "ghcr.io/devcontainers/features/git-lfs:1": {},
  //  https://docs.aws.amazon.com/sdk-for-ruby/v3/api/
     "ghcr.io/devcontainers/features/ruby:1": {
      "version": "3.3"
      },
      // https://docs.aws.amazon.com/sdk-for-java/latest/developer-guide/home.html
      "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      // https://maven.apache.org/what-is-maven.html
      "installMaven": "true"
      
      },
      // https://developer.hashicorp.com/terraform/cli
      "ghcr.io/devcontainers/features/terraform:1": {},
      // Needed for cdk install etc
      "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
  },
  "containerEnv": {
    "AWS_DEFAULT_REGION": "us-east-1",
    "AWS_ACCESS_KEY_ID": "${localEnv:AWS_ACCESS_KEY_ID}",
    "AWS_SECRET_ACCESS_KEY": "${localEnv:AWS_SECRET_ACCESS_KEY}",
    "AWS_CLI_AUTO_PROMPT": "${localEnv:AWS_CLI_AUTO_PROMPT}"
  },
  "postCreateCommand": "npm install -g aws-cdk && cdk --version"
}